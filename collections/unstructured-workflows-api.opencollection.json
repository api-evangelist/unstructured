                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "channel_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
