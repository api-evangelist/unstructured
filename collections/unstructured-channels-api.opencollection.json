{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unstructured Partition channels API",
    "version": "1.5.58"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "unstructured-api-key",
      "value": "{{unstructured-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "channels",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Channels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "enabled",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List account-level notification channels.\n\nReturns all channel configurations for the account (workflow_id=None scope).\nchannel_type is required - no cross-type aggregation."
        },
        {
          "info": {
            "name": "Create Channel",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create notification channel.\n\nCreates a new delivery channel for receiving platform event notifications.\nURL must use HTTPS for webhook type. At least one event type must be specified."
        },
        {
          "info": {
            "name": "Get Channel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels/:channel_id",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get account-level notification channel by ID."
        },
        {
          "info": {
            "name": "Update Channel",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels/:channel_id",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update account-level notification channel.\n\nUpdates an existing channel. Only provided fields are updated."
        },
        {
          "info": {
            "name": "Delete Channel",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels/:channel_id",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete account-level notification channel."
        },
        {
          "info": {
            "name": "Verify Channel",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.unstructuredapp.io/api/v1/notifications/channels/:channel_id/verify",
            "headers": [
              {
                "name": "unstructured-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "channel_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Verify a notification channel using a verification code.\n\nEmail channels require verification by providing the 6-digit code\nsent to the recipient email address during channel creation."
        }
      ]
    }
  ],
  "bundled": true
}